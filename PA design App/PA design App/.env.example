# PA Design App - Environment Configuration Template
# Copy to .env.local and fill in actual values for your environment

# --- Application Settings ---
APP_ENV=development              # development | staging | production
APP_DEBUG=true

# --- Security & Authentication ---
AUTH_ENABLED=false              # Enable RBAC (set to true for production)
API_KEY_OPENAI=                 # OpenAI GPT-4 API key
SESSION_SECRET=your_session_secret_here

# --- Database Connection ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pa_design_app
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# --- Vector DB (Chroma) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_API_KEY=

# --- File Storage ---
UPLOAD_DIR=data/uploads         # Directory for user uploads
EXPORT_DIR=data/exports         # Directory for generated reports
CACHE_DIR=data/cache            # Cache directory

# --- Feature Flags ---
MCP_INTEGRATION=false           # Enable ADS/AWR MCP simulation bridge
ML_PREDICTIONS=true             # Enable ML-based recommendations
CHATBOT=true                    # Enable AI chatbot
REAL_TIME_COLLABORATION=false   # Enable multi-user collaboration

# --- MCP Tool Configuration (if enabled) ---
ADS_TOOL_URL=                   # Keysight ADS server URL
AWR_TOOL_URL=                   # AWR server URL
VNA_TOOL_URL=                   # VNA instrument gateway URL

# --- Logging ---
LOG_LEVEL=info                  # debug | info | warn | error
LOG_DIR=logs

# --- Ports (for docker-compose) ---
APP_PORT=3838
POSTGRES_PORT=5432
CHROMA_PORT=8000
PGADMIN_PORT=5050

# --- Docker Image Versions ---
POSTGRES_VERSION=14
CHROMA_VERSION=latest
